# Segredos e lixo local
api/.env
backend/.env
.env
.env.*
backend/package-lock.json
node_modules/
backend/node_modules/
.venv/
__pycache__/
*.pyc
.vercel/

# Firmware: a configuração tem senha do Wi-Fi e a chave da pochete
firmware/*/config.h

# Originais pesados (passam do limite de 100 MB do GitHub). O site usa as versões
# convertidas: jogo/ (HTML5 tirado do .exe) e assets/video/*.mp4 (H.264)
jogo/*.exe
assets/video/*.MOV
assets/video/*.mov
/*.zip

# Anotações privadas (senhas, chaves): ficam só na máquina
/.LEIA-ME-PRIVADO.md
/gdevelop-game*/
