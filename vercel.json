{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/api/eloa/:path*", "destination": "/api/eloa" },
    { "source": "/api", "destination": "/api/backend" },
    { "source": "/api/:path*", "destination": "/api/backend" }
  ],
  "functions": {
    "api/eloa.py": {
      "maxDuration": 60,
      "excludeFiles": "{assets/**,backend/**,node_modules/**,jogo/**,pages/**,header/**,.venv/**,*.mp4,*.glb}"
    },
    "api/backend.js": {
      "maxDuration": 30
    }
  }
}
