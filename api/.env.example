# Copie para api/.env ou exporte no terminal antes de rodar.
# UMA chave basta; a primeira encontrada (nesta ordem) define o provedor.
# ANTHROPIC_API_KEY=sk-ant-...     Anthropic (pago)
GEMINI_API_KEY=                     

# GROQ_API_KEY=gsk_...              Groq (console.groq.com/keys) — grátis, sem cartão
# OPENAI_API_KEY=sk-...             OpenAI (pago) ou API compatível (com OPENAI_BASE_URL)
# AI_GATEWAY_API_KEY=vck_...        Vercel AI Gateway (exige cartão na Vercel)
# Opcionais
# ELOA_PROVEDOR=gemini              força o provedor quando há mais de uma chave
# ELOA_MODELO=gemini-3.5-flash      modelo (padrão por provedor no topo de eloa.py)
# ELOA_ESFORCO=low
# PORT=8000
