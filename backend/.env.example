# Copie para backend/.env (nao vai para o git). No servidor da escola, o usuario
# "alunos" so pode criar bancos com o prefixo alunos_ (ex.: alunos_elo).
PORT=3000
# [A] MySQL da sua maquina (contas so suas). A senha e a que voce definiu ao
#     instalar o MySQL; sem ela o terminal mostra "Access denied ... (using
#     password: NO)" e o servidor sai.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alunos_elo
# [B] MySQL da escola: as MESMAS contas do site publicado. Comente o bloco de
#     cima e descomente este (a senha do usuario "alunos" esta no painel da
#     Vercel, como Secret: so quem a definiu consegue informa-la de novo).
# DB_HOST=benserverplex.ddns.net
# DB_PORT=3306
# DB_USER=alunos
# DB_PASSWORD=
# DB_NAME=alunos_elo
# Sem nenhuma senha em maos: abra o site com ?api=publicado e o navegador fala
# com o backend ja publicado, sem precisar de backend local (README, secao 6).
# Origens que podem chamar a API (em producao, o dominio do site). * libera tudo.
ALLOWED_ORIGINS=*
# Dias que uma sessao (login) dura
SESSION_DAYS=30

# --- Uber (Guest Rides API; exige conta Uber for Business aprovada) ---
# Sem estas duas variaveis, as corridas sao SIMULADAS.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# UBER_SANDBOX=1
# UBER_ORG_UUID=

# --- Telegram (crie o bot com o @BotFather) ---
# Sem o token, as mensagens vao para o console (simulado).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Abaixo deste percentual, a pochete avisa "bateria baixa"
BATERIA_BAIXA=20

# --- E-mail dos formularios do site (contato e pedido) ---
# Para onde vao as mensagens de "Entre em contato" e "Quero uma ELO".
EMAIL_EMPRESA=elocompany.pochete@gmail.com
# CAMINHO CURTO quando o endereco acima e um Gmail: mandar por ele mesmo.
# Ative a verificacao em duas etapas na conta e gere uma Senha de App em
# myaccount.google.com/apppasswords (16 letras; a senha normal nao funciona).
GMAIL_APP_PASSWORD=
# Alternativa sem 2 etapas: chave da Brevo (brevo.com > SMTP & API), gratuita,
# 300 e-mails/dia, basta verificar o remetente em Senders & IP.
BREVO_API_KEY=
# Alternativa: RESEND_API_KEY= (exige dominio proprio verificado)
# Outro servidor SMTP no lugar do Gmail: EMAIL_SMTP_HOST= e EMAIL_SMTP_PORTA=
# De quem sai o e-mail (padrao: o proprio EMAIL_EMPRESA; precisa ser verificado)
EMAIL_REMETENTE=
# Nome que aparece como remetente
EMAIL_NOME=ELO
# EMAIL_COPIA=0 desliga a confirmacao automatica para quem preencheu o formulario
# Contas que podem ler /api/mensagens (padrao: a do EMAIL_EMPRESA)
ADMIN_EMAILS=
# Mensagens por hora do mesmo e-mail/IP antes de responder 429
MENSAGENS_POR_HORA=5
